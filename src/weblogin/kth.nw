def test_SAMLlogin_reruns_at_most_once():
  services = FakeServices({
    ("GET", f"{SP}/api"):
      lambda r: (302, {"Location": IDP_REDIRECT_SSO + "?execution=e1s1"}, ""),
    ("GET", IDP_REDIRECT_SSO): lambda r: (200, {}, relay_form(f"{SP}/acs")),
    ("POST", f"{SP}/acs"): lambda r: (200, {}, "not accepted"),
  })
  session = session_with(
    services, weblogin.kth.SAMLlogin(rerun_requests=True))

  response = session.get(f"{SP}/api")

  assert services.count("GET", f"{SP}/api") == 2
  assert response.text == "not accepted"
