handler.

<<test functions>>=
def test_microsoftlogin_detects_authorize_url():
  handler = microsoft.MicrosoftLogin(domain_hint="ug.kth.se")
  assert handler.need_login(MockResponse("", url=AUTHORIZE_URL))
